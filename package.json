{
  "name": "ghadhul-bashar",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "غض البصر (Ghadhul Bashar) — High-speed, 100% on-device surgical AI gaze-protection browser extension",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "models:prepare": ".venv/bin/python scripts/models/prepare-models.py",
    "models:optimize": ".venv/bin/python scripts/models/prepare-models.py --optimize-wasm",
    "models:verify": ".venv/bin/python scripts/models/prepare-models.py --verify",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "build": "node scripts/build-extension.mjs",
    "zip": "node scripts/build-extension.mjs --zip",
    "policy:generate": "node scripts/policy-lock/generate-policy.mjs",
    "benchmark": "node scripts/benchmark-cascade.mjs",
    "audit:sites": "node scripts/audit-sites.mjs",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "playwright-core": "^1.51.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
